# Copy this file to ".env" and adjust.
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173
# Public URL of the website (used in emails and sitemap)
SITE_URL=http://localhost:5173
# Public URL of this API (used to build image/file links)
API_PUBLIC_URL=http://localhost:5000

# XAMPP MySQL/MariaDB defaults: user "root", empty password, port 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devlab_db

# Change this to a long random string (32+ characters; required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account, created by "npm run db:init"
ADMIN_NAME=Lab Admin
ADMIN_EMAIL=admin@devlab.local
ADMIN_PASSWORD=ChangeMe123!

# ---- Email (optional). Leave SMTP_HOST empty to just print emails in the console ----
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=devlabcollective@gmail.com, SMTP_PASS=<a Google "App password" — not your normal password>
#   (Google account → Security → 2-Step Verification → App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevLab Collective <devlabcollective@gmail.com>
# Where "new contact message / new application" alerts are sent
NOTIFY_EMAIL=devlabcollective@gmail.com

# ---- Captcha (optional): Cloudflare Turnstile secret key. Empty = captcha disabled ----
TURNSTILE_SECRET=

# ---- GitHub stats (optional): token raises the API rate limit from 60 to 5000 requests/hour ----
GITHUB_TOKEN=

# Blog comments appear immediately (true) or wait for admin approval (false)
COMMENTS_AUTO_APPROVE=false
