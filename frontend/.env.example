# URL of the DevLab API (backend). Restart `npm run dev` after changing it.
VITE_API_URL=http://localhost:5000/api

# Optional: Cloudflare Turnstile SITE key (public). Leave empty to disable the captcha widget.
# The matching secret goes in backend/.env as TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
